from google.colab import files
from IPython.display import Video
import cv2

# Upload a video
uploaded = files.upload()

video_path = list(uploaded.keys())[0]

# Open the uploaded video
cap = cv2.VideoCapture(video_path)

# Get video properties
fps = cap.get(cv2.CAP_PROP_FPS)
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

# Create output videos
slow = cv2.VideoWriter('slow_motion.mp4',
                       cv2.VideoWriter_fourcc(*'mp4v'),
                       fps/2, (width, height))

fast = cv2.VideoWriter('fast_motion.mp4',
                       cv2.VideoWriter_fourcc(*'mp4v'),
                       fps*2, (width, height))

while True:
    ret, frame = cap.read()
    if not ret:
        break

    slow.write(frame)
    fast.write(frame)

cap.release()
slow.release()
fast.release()

print("Slow Motion Video")
display(Video("slow_motion.mp4", embed=True))

print("Fast Motion Video")
display(Video("fast_motion.mp4", embed=True))
